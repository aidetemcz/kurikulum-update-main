# --- Supabase ---
# Najdeš v Supabase projektu: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Tajný klíč, POUZE pro server (nikdy nedávat do prohlížeče / NEXT_PUBLIC_).
# Používá se pro administraci uživatelů (pozvání nového čtenáře/editora).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- E-maily (upozornění na změny) přes SMTP vaší schránky ---
# Adresa schránky a heslo pro aplikace z Google účtu (viz README, krok 2)
SMTP_USER=aplikace@tvoje-domena.cz
SMTP_PASSWORD=abcd efgh ijkl mnop
# Nepovinné: jméno odesílatele a jiný SMTP server než Gmail
# SMTP_FROM_NAME="AI kurikulum"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Appka ---
# Veřejná URL appky (lokálně http://localhost:3000, na Vercelu URL projektu)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
